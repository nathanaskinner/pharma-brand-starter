<section class="section{% if section.background %} section--{{ section.background }}{% endif %}">
  <div class="container prose">
    {% if section.heading %}<h2{% editable "text", "heading" %}>{{ section.heading }}</h2>{% endif %}
    <div{% editable "text", "body", { type: "block" } %}>{{ section.body | md | safe }}</div>
  </div>
</section>
