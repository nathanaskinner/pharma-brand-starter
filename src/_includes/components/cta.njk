<section class="section section--brand">
  <div class="container cta">
    <h2{% editable "text", "heading" %}>{{ section.heading }}</h2>
    {% if section.body %}<p{% editable "text", "body", { type: "span" } %}>{{ section.body }}</p>{% endif %}
    {% if section.cta.label %}<a class="button button--light" href="{{ section.cta.url }}"{% editable "text", "cta.label", { type: "span" } %}>{{ section.cta.label }}</a>{% endif %}
  </div>
</section>
