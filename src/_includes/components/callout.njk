<section class="section">
  <div class="container">
    <div class="callout">
      <div class="callout__text"{% editable "text", "text" %}>{{ section.text | md | safe }}</div>
      {% if section.cta %}<a class="button" href="{{ section.cta.url }}"{% editable "text", "cta.label", { type: "span" } %}>{{ section.cta.label }}</a>{% endif %}
    </div>
  </div>
</section>
